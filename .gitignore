venv/
*.log
infos
.env
__pycache__/
__init__.py
data/
.aider*
*.out
.mypy_cache/

# Chainlit's local blob cache for message elements (attached PDFs, etc.) -
# runtime-only, recreated on demand.
.files/

# Generated per container at startup from the baked-in course (see
# chainlit_app.py). chainlit.md is the tracked static fallback.
chainlit_pt-BR.md

# Chainlit re-scaffolds every non-existent language file from its own
# defaults on every `chainlit run` - only our pt-BR override is real.
.chainlit/translations/*.json
!.chainlit/translations/pt-BR.json